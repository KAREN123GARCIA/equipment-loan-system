generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoanStatus {
  ACTIVE
  RETURNED
  CANCELED
}

model Loan {
  id          String @id @default(uuid())
  userId      String
  equipmentId String

  status LoanStatus @default(ACTIVE)

  startDate  DateTime  @default(now())
  dueDate    DateTime?
  returnedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([equipmentId])
  @@map("loans")
}
