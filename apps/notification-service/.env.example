PORT=3006
NODE_ENV=development
GLOBAL_PREFIX=api/v1
CORS_ORIGINS=*
AUTH_REQUIRED=true

JWT_SECRET=dev_only_change_me
JWT_ISSUER=auth-service
JWT_AUDIENCE=equipment-loan

MONGODB_URI=mongodb://mongo-notification:27017/notification_db

EMAIL_TRANSPORT=mailhog
EMAIL_FROM="Equipment Loan <no-reply@example.com>"

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=pass

MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

DELIVERY_MAX_ATTEMPTS=5
DELIVERY_INITIAL_BACKOFF_MS=2000
DELIVERY_MAX_BACKOFF_MS=60000

INTEGRATION_SERVICE_EVENTS_URL=http://localhost:3010/api/v1/events
EVENTS_SOURCE=notification-service

EVENTS_BROKER_TYPE=none
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672
MQTT_URL=mqtt://localhost:1883

METRICS_PATH=/metrics
LOG_LEVEL=info

ENABLE_DEV_EVENTS=true
DEV_EVENTS_TOKEN=dev-events-change-me
